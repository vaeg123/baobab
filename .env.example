# ── Base de données (Neon via intégration Vercel) ─────────────────────────────
DATABASE_URL=postgresql://baobab:baobab@localhost:5432/baobab

# ── Sécurité ──────────────────────────────────────────────────────────────────
# ENVIRONMENT=production active des vérifications strictes au démarrage
# (baobab/config.py) : l'application refuse de démarrer si SECRET_KEY,
# JWT_SECRET, BAOBAB_SUPERADMIN_TOKEN ou BAOBAB_ADMIN_KEY sont absents,
# trop courts (<32 caractères) ou laissés à leur valeur d'exemple.
#
# Générer un secret fort : `openssl rand -hex 32`
ENVIRONMENT=development
SECRET_KEY=change-me-in-production
JWT_SECRET=change-me-in-production

# Origines autorisées pour le CORS (séparées par des virgules).
# Ne JAMAIS utiliser "*" en production.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Expose /api/docs et /api/redoc même en environnement de production
# (désactivé par défaut en production : réduit la surface de reconnaissance).
EXPOSE_API_DOCS=false

# ── IA (optionnel) ────────────────────────────────────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── PISTE — Droit français (Judilibre + Légifrance) ───────────────────────────
# Ne jamais committer PISTE_CLIENT_SECRET
PISTE_CLIENT_ID=
PISTE_CLIENT_SECRET=
PISTE_TOKEN_URL=https://sandbox-oauth.piste.gouv.fr/api/oauth/token
PISTE_SCOPE=openid
JUDILIBRE_API_BASE_URL=https://sandbox-api.piste.gouv.fr/cassation/judilibre/v1.0
LEGIFRANCE_API_BASE_URL=https://sandbox-api.piste.gouv.fr/dila/legifrance/lf-engine-app

# ── Europe et international ──────────────────────────────────────────────────
# EUR-Lex nécessite un compte EU Login pour son webservice. Pour les volumes
# importants, utiliser CELLAR ou les dumps officiels après revue des conditions.
EURLEX_WEBSERVICE_URL=https://eur-lex.europa.eu/EURLexWebService
EURLEX_USERNAME=
EURLEX_PASSWORD=
CELLAR_API_BASE_URL=https://publications.europa.eu/resource/cellar
HUDOC_BASE_URL=https://hudoc.echr.coe.int

# ── Neo4j (optionnel) ─────────────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=baobab

# ── Admin ─────────────────────────────────────────────────────────────────────
# BAOBAB_ADMIN_KEY  : clé d'administration du back-office soumissions.
# BAOBAB_SUPERADMIN_TOKEN : jeton à usage unique pour créer LE PREMIER compte
#   superadmin via POST /api/v1/superadmin/setup. Aucune valeur par défaut
#   n'est acceptée : sans cette variable, l'endpoint est désactivé (503).
BAOBAB_ADMIN_KEY=change-me-in-production
BAOBAB_SUPERADMIN_TOKEN=change-me-in-production

# Authentifie les appels planifiés Vercel vers le moteur de veille.
# Générer une valeur aléatoire d'au moins 32 caractères.
CRON_SECRET=

# Adresse recevant les alertes internes (nouveau client, paiement en
# attente). Laisser vide désactive silencieusement ces notifications
# plutôt que d'échouer.
BAOBAB_ADMIN_EMAIL=

# ── Notifications email (Resend) ───────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
RESEND_FROM=BAOBAB <noreply@baobab.legal>
APP_URL=https://baobab.legal
